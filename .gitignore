# MindSync - Git Ignore

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
.obsidian/
*.iml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
data/
Clippings/
*.tmp
.playwright-cli/

# Secrets (never commit!)
*.pem
*.key
.env
.env.local
.claude/settings.local.json
secrets/

# Node modules (if any)
node_modules/
projects/relayhub/console/dist/
projects/research-center/research/心理疗愈app/心理疗愈AI产品观察室/dist/
projects/content-matrix/内容视觉工坊/dist/
projects/content-matrix/内容视觉工坊V2/dist/
projects/relayhub/control-plane/data/
projects/aimandala/toC/app/backend/data/
projects/content-matrix/内容视觉工坊/outputs/

# Python cache
__pycache__/
*.pyc
*.pyo

# Large files
*.zip
*.tar.gz
*.rar

# Course recordings and packaged materials (课程录屏与打包资料)
projects/research-center/courses/2026年企业级AI编程实战营/**/*.sz
projects/research-center/courses/2026年企业级AI编程实战营/**/*.zip
projects/research-center/courses/AI业务流架构师训练营/**/*.sz
projects/research-center/courses/AI业务流架构师训练营/**/*.zip

# External dependencies (managed separately)
external/*/
!external/.gitkeep

# Archive (keep structure but ignore large/old files)
archive/**/*.zip
archive/**/*.tar.gz

# Generated card images (图片不进 git)
projects/content-matrix/accounts/墨予镜/小红书出图/

# 抓取的公众号原文快照（中间产物，风格已抽成 styles/*.json）
projects/content-matrix/accounts/墨予镜/reference-samples/*/content.html
projects/content-matrix/accounts/墨予镜/reference-samples/*/meta.json
