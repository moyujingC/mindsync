# MindSync - Git Ignore

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
.obsidian/
*.iml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
.playwright-cli/

# Secrets (never commit!)
*.pem
*.key
.env
.env.local
secrets/

# Node modules (if any)
node_modules/
projects/relayhub/console/dist/
projects/relayhub/control-plane/data/
projects/aimandala/toC/app/backend/data/

# Python cache
__pycache__/
*.pyc
*.pyo

# Large files
*.zip
*.tar.gz
*.rar

# External dependencies (managed separately)
external/*/
!external/.gitkeep

# Archive (keep structure but ignore large/old files)
archive/**/*.zip
archive/**/*.tar.gz
