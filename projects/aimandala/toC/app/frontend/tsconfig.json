{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@aimandala/shared": [
        "./shared/index.ts"
      ],
      "@aimandala/shared/*": [
        "./shared/*"
      ],
      "@aimandala/design-system": [
        "./shared/design-system/index.ts"
      ],
      "@aimandala/design-system/*": [
        "./shared/design-system/*"
      ],
      "@aimandala/shared-ui": [
        "./shared/ui/index.ts"
      ],
      "@aimandala/shared-ui/*": [
        "./shared/ui/*"
      ],
      "@aimandala/mobile-web": [
        "./mobile-web/index.ts"
      ],
      "@aimandala/mobile-web/*": [
        "./mobile-web/*"
      ]
    }
  },
  "include": [
    "./shared/design-system/**/*.ts",
    "./shared/design-system/**/*.tsx",
    "./shared/ui/**/*.ts",
    "./shared/ui/**/*.tsx",
    "./shared/**/*.ts",
    "./shared/**/*.tsx",
    "./mobile-web/**/*.ts",
    "./mobile-web/**/*.tsx",
    "./mobile-web/**/*.d.ts"
  ]
}
