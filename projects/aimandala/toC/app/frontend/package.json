{
  "name": "@mindsync/aimandala-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:shared": "tsc --noEmit -p tsconfig.json",
    "check:shared-ui": "tsc --noEmit -p tsconfig.json",
    "dev:mobile-web": "vite",
    "build:mobile-web": "vite build",
    "preview:mobile-web": "vite preview",
    "assets:process-image": "python3 scripts/process-image.py",
    "dev:note": "node -e \"console.log('Mobile-web runtime shell now uses Vite. Run npm run dev:mobile-web to start local development.')\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.18",
    "vitest": "^4.1.3"
  }
}
