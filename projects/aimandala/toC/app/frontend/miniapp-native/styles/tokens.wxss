:root,
page {
  --am-color-sand-150: #f0e6d6;
  --am-color-clay-800: #4a3d30;
  --am-color-clay-700: #5e5046;
  --am-color-gold-300: #d4a054;
  --am-color-danger-600: #7a3023;

  --am-surface-primary: var(--am-color-sand-150);
  --am-surface-primary-soft: #f6f0e8;
  --am-surface-primary-elevated: #f1e6d6;
  --am-text-primary: var(--am-color-clay-800);
  --am-text-secondary: var(--am-color-clay-700);
  --am-text-accent: var(--am-color-gold-300);
  --am-status-danger: var(--am-color-danger-600);

  --am-font-body: "Noto Sans SC", "PingFang SC", "Hiragino Sans GB", sans-serif;
  --am-font-display: "Noto Serif SC", "Songti SC", serif;
  --am-text-title-rpx: 40rpx;
  --am-text-body-rpx: 28rpx;
  --am-leading-body: 1.6;
}
