########################################
# AIMandala Wealth Regression Example
# Copy to a private file outside git, for example:
#   /Users/<you>/secrets/aimandala.regression.env
########################################

# --- Text / chat model ---
# Defaults are DeepSeek v4 compatible.
AIMANDALA_LLM_API_KEY=__REPLACE_WITH_DEEPSEEK_API_KEY__
AIMANDALA_LLM_BASE_URL=https://api.deepseek.com
AIMANDALA_LLM_MODEL=deepseek-v4-pro
AIMANDALA_LLM_CHAT_MODEL=deepseek-v4-pro

# --- Vision model ---
# Choose one route. Primary vision is used first.
AIMANDALA_LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIMANDALA_LLM_VISION_MODEL=qwen-vl-max-latest
AIMANDALA_LLM_VISION_API_KEY=__REPLACE_WITH_DASHSCOPE_API_KEY__

# Optional fallback vision route.
# AIMANDALA_LLM_VISION_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AIMANDALA_LLM_VISION_FALLBACK_MODEL=qwen-vl-max-latest
# AIMANDALA_LLM_VISION_FALLBACK_API_KEY=__REPLACE_WITH_FALLBACK_VISION_API_KEY__

# --- Redeem codes ---
# Only required for /api/wealth-reports E2E checks.
# The agent regression runner does not require redeem codes.
AIMANDALA_REDEEM_CODES=REGRESSION-LITE:lite;REGRESSION-PRO:pro;REGRESSION-ALL:lite,pro

# --- Request behavior ---
AIMANDALA_LLM_TIMEOUT_SECONDS=60
AIMANDALA_LLM_MAX_RETRIES=1
AIMANDALA_LLM_RETRY_BACKOFF_MS=500
