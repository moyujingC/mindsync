########################################
# AIMandala Backend - Staging Example
# Copy to .env.staging and replace secret placeholders outside git.
########################################

# --- Runtime mode ---
AIMANDALA_LLM_BACKEND=openai_compatible
AIMANDALA_UPLOAD_BACKEND=local

# --- Text / chat model ---
# MVP text model decision: DeepSeek V4. Keep actual endpoint and key in private env.
AIMANDALA_LLM_BASE_URL=__REPLACE_WITH_TEXT_OPENAI_COMPATIBLE_BASE_URL__
AIMANDALA_LLM_API_KEY=__REPLACE_WITH_TEXT_API_KEY__
AIMANDALA_LLM_MODEL=deepseek-v4-pro
AIMANDALA_LLM_CHAT_MODEL=deepseek-v4-pro

# --- Vision model ---
# Default: Qwen VL via DashScope.
AIMANDALA_LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIMANDALA_LLM_VISION_MODEL=qwen-vl-max-latest
AIMANDALA_LLM_VISION_API_KEY=__REPLACE_WITH_DASHSCOPE_API_KEY__

# Fallback: Doubao Seed vision via Volcengine Ark.
AIMANDALA_LLM_VISION_FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AIMANDALA_LLM_VISION_FALLBACK_MODEL=ep-20260316095322-94wf5
AIMANDALA_LLM_VISION_FALLBACK_API_KEY=__REPLACE_WITH_DOUBAO_API_KEY__

# --- Request behavior ---
AIMANDALA_LLM_TIMEOUT_SECONDS=45
AIMANDALA_LLM_MAX_RETRIES=1
AIMANDALA_LLM_RETRY_BACKOFF_MS=500
