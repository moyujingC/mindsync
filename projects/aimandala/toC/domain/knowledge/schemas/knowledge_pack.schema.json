{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aimandala Knowledge Pack Manifest",
  "type": "object",
  "required": ["pack_id", "schema_version", "status", "entries"],
  "properties": {
    "pack_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "v2.1" },
    "status": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "entries": {
      "type": "object",
      "required": ["elements", "circles", "themes", "rules", "healing", "narrative"],
      "properties": {
        "elements": {
          "type": "array",
          "items": { "type": "string", "pattern": "^elements/.+\\.ya?ml$" }
        },
        "circles": {
          "type": "array",
          "items": { "type": "string", "pattern": "^circles/.+\\.ya?ml$" }
        },
        "themes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^themes/.+\\.ya?ml$" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^rules/.+\\.ya?ml$" }
        },
        "healing": {
          "type": "array",
          "items": { "type": "string", "pattern": "^healing/.+\\.ya?ml$" }
        },
        "narrative": {
          "type": "array",
          "items": { "type": "string", "pattern": "^narrative/.+\\.ya?ml$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
