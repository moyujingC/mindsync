# AIMandala release docker environment

# Host ports for parallel validation on the production machine.
HOST_FRONTEND_PORT=8101
HOST_BACKEND_PORT=8100

# Frontend runtime base URL baked at build time.
VITE_AIMANDALA_API_BASE_URL=https://web-api.jingshu.cc

# Formal release runtime defaults.
AIMANDALA_LLM_BACKEND=openai_compatible
AIMANDALA_UPLOAD_BACKEND=cos
AIMANDALA_ENABLE_DEBUG_WORKBENCH=0

# Required redeem-code settings in release.
# Format: CODE-LITE:lite;CODE-PRO:pro;CODE-ALL:lite,pro
# Use private real codes in .env.release. Do not commit live codes.
# AIMANDALA_REDEEM_CODES=

# Required COS settings in release.
# AIMANDALA_UPLOAD_COS_SECRET_ID=
# AIMANDALA_UPLOAD_COS_SECRET_KEY=
# AIMANDALA_UPLOAD_COS_BUCKET=
# AIMANDALA_UPLOAD_COS_REGION=ap-shanghai
# AIMANDALA_UPLOAD_COS_KEY_PREFIX=aimandala/uploads
# AIMANDALA_UPLOAD_COS_PUBLIC_BASE_URL=https://img.jingshu.cc
# AIMANDALA_COS_SIGNED_URL_TTL_SECONDS=900

# Required unified LLM settings in release.
# AIMANDALA_LLM_BASE_URL=https://api.deepseek.com/v1
# AIMANDALA_LLM_API_KEY=<your-api-key>
# AIMANDALA_LLM_API_KEY_HEADER=Authorization
# AIMANDALA_LLM_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_CHAT_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_VISION_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_TIMEOUT_SECONDS=30
# AIMANDALA_LLM_MAX_RETRIES=2
# AIMANDALA_LLM_RETRY_BACKOFF_MS=400
