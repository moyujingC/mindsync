# AIMandala gray docker environment for miniapp live verification

# Run gray separately from the current release ports.
HOST_FRONTEND_PORT=8201
HOST_BACKEND_PORT=8200

# Gray H5 runtime base URL baked into the frontend build.
VITE_AIMANDALA_API_BASE_URL=https://web-api-gray.jingshu.cc

# Gray runtime defaults.
AIMANDALA_LLM_BACKEND=openai_compatible
AIMANDALA_UPLOAD_BACKEND=cos
AIMANDALA_ENABLE_DEBUG_WORKBENCH=0
AIMANDALA_MINIAPP_PAYMENT_MODE=wechatpay-live
AIMANDALA_MINIAPP_WECHATPAY_NOTIFY_DEV_FALLBACK=false

# Required shared runtime config.
# AIMANDALA_UPLOAD_COS_SECRET_ID=
# AIMANDALA_UPLOAD_COS_SECRET_KEY=
# AIMANDALA_UPLOAD_COS_BUCKET=
# AIMANDALA_UPLOAD_COS_REGION=ap-shanghai
# AIMANDALA_UPLOAD_COS_KEY_PREFIX=aimandala/uploads
# AIMANDALA_UPLOAD_COS_PUBLIC_BASE_URL=https://img.jingshu.cc
# AIMANDALA_COS_SIGNED_URL_TTL_SECONDS=900
# AIMANDALA_LLM_BASE_URL=https://api.deepseek.com/v1
# AIMANDALA_LLM_API_KEY=<your-api-key>
# AIMANDALA_LLM_API_KEY_HEADER=Authorization
# AIMANDALA_LLM_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_CHAT_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_VISION_MODEL=deepseek-v4-pro
# AIMANDALA_LLM_TIMEOUT_SECONDS=30
# AIMANDALA_LLM_MAX_RETRIES=2
# AIMANDALA_LLM_RETRY_BACKOFF_MS=400

# Miniapp gray must explicitly configure all of the following.
# AIMANDALA_MINIAPP_WECHAT_APP_ID=wx<miniapp-appid>
# AIMANDALA_MINIAPP_WECHAT_APP_SECRET=<miniapp-app-secret>
# AIMANDALA_MINIAPP_WECHAT_SESSION_BASE_URL=https://api.weixin.qq.com
# AIMANDALA_MINIAPP_WECHATPAY_APP_ID=wx<miniapp-appid>
# AIMANDALA_MINIAPP_WECHATPAY_MCH_ID=<wechatpay-mchid>
# AIMANDALA_MINIAPP_WECHATPAY_MCH_CERT_SERIAL_NO=<merchant-cert-serial>
# AIMANDALA_MINIAPP_WECHATPAY_PRIVATE_KEY_PATH=/run/secrets/aimandala-miniapp-wechatpay-private-key.pem
# AIMANDALA_MINIAPP_WECHATPAY_API_V3_KEY=<32-byte-api-v3-key>
# AIMANDALA_MINIAPP_WECHATPAY_NOTIFY_URL=https://web-api-gray.jingshu.cc/api/v2/miniapp/payments/wechat/callback
# AIMANDALA_MINIAPP_WECHATPAY_PLATFORM_CERT_PATH=/run/secrets/aimandala-miniapp-wechatpay-platform-cert.pem
# AIMANDALA_MINIAPP_WECHATPAY_PLATFORM_CERT_SERIAL=<platform-cert-serial>
# AIMANDALA_MINIAPP_WECHATPAY_ORDER_EXPIRE_MINUTES=15
