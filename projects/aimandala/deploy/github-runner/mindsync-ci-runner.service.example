[Unit]
Description=MindSync GitHub Actions self-hosted runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mindsync-ci/actions-runner
ExecStart=/opt/mindsync-ci/actions-runner/run.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
