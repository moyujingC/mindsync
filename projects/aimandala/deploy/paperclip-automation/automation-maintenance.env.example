# /etc/default/automation-maintenance

TZ=Asia/Shanghai
RUNNER_ROOT=/opt/mindsync-ci/actions-runner
REPO_ROOT=/opt/automation/app/mindsync
HEARTBEAT_REPO_ROOT=/opt/automation/app/mindsync-heartbeat
EXECUTION_WORKTREE_ROOT=/opt/automation/worktrees
PAPERCLIP_HOME=/data/paperclip
MIN_FREE_GB=12
TEMP_RETENTION_DAYS=3
RUNNER_LOG_RETENTION_DAYS=7
PAPERCLIP_LOG_GZIP_AFTER_DAYS=3
PAPERCLIP_LOG_RETENTION_DAYS=30
WORKTREE_RETENTION_DAYS=3
PAPERCLIP_API_BASE=http://127.0.0.1:3100
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=be191a6e-7447-4821-a93d-9114214c4a64
PAPERCLIP_PROJECT_NAME=一镜一梳
PAPERCLIP_ENGINEER_AGENT_ID=fd835fc1-7e14-487f-ba02-45eed5f6c221
PAPERCLIP_ESCALATION_USER_ID=
# 当前建议填写为公司 owner 的 Paperclip user id；在当前实例中，墨予镜 owner 已实测为 Ez0pPScGvIP9IbYXCmcKkiP2IXwSK0ZP
PAPERCLIP_ENGINEER_ESCALATE_MAX_FAILURE_COMMENTS=3
PAPERCLIP_ENGINEER_ESCALATE_MAX_AGE_MINUTES=90
PAPERCLIP_ENGINEER_ESCALATE_INCLUDE_AGE_THRESHOLD=0
PAPERCLIP_ENGINEER_ESCALATE_INCLUDE_PUBLIC_BLOCKER=0
PAPERCLIP_ENGINEER_ESCALATE_APPLY=0
