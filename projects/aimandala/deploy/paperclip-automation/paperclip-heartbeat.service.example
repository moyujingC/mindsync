[Unit]
Description=Paperclip runner heartbeat sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/default/paperclip-heartbeat
WorkingDirectory=/opt/automation/app/mindsync-heartbeat
ExecStart=/usr/bin/env bash -lc 'node shared/tools/ci/paperclip-multi-project-heartbeat.mjs --repository "$GITHUB_REPOSITORY" --github-token "$GITHUB_TOKEN" --company-id "$PAPERCLIP_COMPANY_ID" --api-base "$PAPERCLIP_API_BASE" --api-key "$PAPERCLIP_API_KEY" --owner-agent-id "$PAPERCLIP_ENGINEER_AGENT_ID" --runner-name "${RUNNER_HEARTBEAT_RUNNER_NAME:-mindsync-ci}" --max-queued-minutes "${RUNNER_HEARTBEAT_MAX_QUEUED_MINUTES:-20}" --max-success-age-hours "${RUNNER_HEARTBEAT_MAX_SUCCESS_AGE_HOURS:-24}" --stale-minutes "${PAPERCLIP_EXECUTION_STALE_MINUTES:-15}" --expected-root "${PAPERCLIP_SERVER_WRITABLE_ALLOWED_ROOT:-/opt/automation/worktrees}" --execution-adapter "${PAPERCLIP_EXECUTION_ADAPTER:-github-actions/self-hosted-runner:runner-heartbeat}" --execution-host "${PAPERCLIP_EXECUTION_HOST:-automation@150.158.9.95}" --apply 0 --strict 1'
