[Unit]
Description=Paperclip runner heartbeat sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/default/paperclip-heartbeat
WorkingDirectory=/opt/automation/app/mindsync-heartbeat
ExecStart=/usr/bin/env bash -lc 'node shared/tools/ci/check-runner-heartbeat.mjs --repository "$GITHUB_REPOSITORY" --github-token "$GITHUB_TOKEN" --company-id "$PAPERCLIP_COMPANY_ID" --api-base "$PAPERCLIP_API_BASE" --api-key "$PAPERCLIP_API_KEY" --owner-agent-id "$PAPERCLIP_ENGINEER_AGENT_ID" --branch "${RUNNER_HEARTBEAT_BRANCH:-main}" --workflow-file "${RUNNER_HEARTBEAT_WORKFLOW_FILE:-aimandala-ci.yml}" --runner-name "${RUNNER_HEARTBEAT_RUNNER_NAME:-mindsync-ci}" --expect-labels "${RUNNER_HEARTBEAT_EXPECT_LABELS:-self-hosted,linux,mindsync-ci,aimandala}" --max-queued-minutes "${RUNNER_HEARTBEAT_MAX_QUEUED_MINUTES:-20}" --max-success-age-hours "${RUNNER_HEARTBEAT_MAX_SUCCESS_AGE_HOURS:-24}" && node shared/tools/ci/check-paperclip-execution-health.mjs --company-id "$PAPERCLIP_COMPANY_ID" --project-name "一镜一梳" --api-base "$PAPERCLIP_API_BASE" --api-key "$PAPERCLIP_API_KEY" --stale-minutes "${PAPERCLIP_EXECUTION_STALE_MINUTES:-15}" --apply --strict'
