# /etc/default/paperclip-heartbeat

GITHUB_REPOSITORY=moyujingC/mindsync
GITHUB_TOKEN=replace-with-github-token
# token 至少需要读取 workflow runs 与 repository self-hosted runners；
# 若需要重注册 runner，建议使用具备 runner read/admin 范围的 fine-grained token

PAPERCLIP_API_BASE=http://127.0.0.1:3100
PAPERCLIP_API_KEY=replace-with-paperclip-api-key
PAPERCLIP_COMPANY_ID=be191a6e-7447-4821-a93d-9114214c4a64
PAPERCLIP_ENGINEER_AGENT_ID=fd835fc1-7e14-487f-ba02-45eed5f6c221

RUNNER_HEARTBEAT_BRANCH=main
RUNNER_HEARTBEAT_WORKFLOW_FILE=aimandala-ci.yml
RUNNER_HEARTBEAT_RUNNER_NAME=mindsync-ci
RUNNER_HEARTBEAT_EXPECT_LABELS=self-hosted,linux,mindsync-ci,aimandala
RUNNER_HEARTBEAT_MAX_QUEUED_MINUTES=20
RUNNER_HEARTBEAT_MAX_SUCCESS_AGE_HOURS=24
PAPERCLIP_EXECUTION_STALE_MINUTES=15
