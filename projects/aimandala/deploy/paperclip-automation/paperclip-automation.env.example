# /etc/default/paperclip-automation

PAPERCLIP_PORT=3100
PAPERCLIP_BIND=lan
PAPERCLIP_PUBLIC_URL=http://automation-node.tailnet.ts.net:3100
PAPERCLIP_TAILNET_BIND_HOST=
BETTER_AUTH_SECRET=replace-with-a-long-random-string

PAPERCLIP_DATA_DIR=/data/paperclip
MINDSYNC_REPO=/opt/automation/app/mindsync
USER_UID=1000
USER_GID=1000

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Optional outbound proxy for slow international egress.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
http_proxy=
https_proxy=
no_proxy=
