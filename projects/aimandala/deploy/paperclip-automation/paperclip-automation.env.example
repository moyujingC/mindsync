# /etc/default/paperclip-automation

TZ=Asia/Shanghai
PAPERCLIP_PORT=3100
PAPERCLIP_BIND=lan
PAPERCLIP_PUBLIC_URL=http://automation-node.tailnet.ts.net:3100
PAPERCLIP_TAILNET_BIND_HOST=
BETTER_AUTH_SECRET=replace-with-a-long-random-string

PAPERCLIP_DATA_DIR=/data/paperclip
MINDSYNC_REPO=/opt/automation/app/mindsync
PAPERCLIP_HEARTBEAT_REPO=/opt/automation/app/mindsync-heartbeat
PAPERCLIP_EXECUTION_WORKTREE_ROOT=/opt/automation/worktrees
AIMANDALA_SERVER_WRITABLE_ALLOWED_ROOT=/opt/automation/worktrees
AIMANDALA_AUTO_REPAIR_BRANCH_PREFIX=automation/aimandala
USER_UID=1000
USER_GID=1000
PAPERCLIP_EXECUTION_HOST=automation@150.158.9.95

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Hermes/CEO 默认复用 OPENAI_*。
# 若接火山引擎 Coding Plan，可直接设置：
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# OPENAI_MODEL=minimax-m2.5

# Optional outbound proxy for slow international egress.
# Current company shared proxy:
#   host: 47.253.255.110
#   service: tinyproxy
#   port: 18888
HTTP_PROXY=http://47.253.255.110:18888
HTTPS_PROXY=http://47.253.255.110:18888
NO_PROXY=127.0.0.1,localhost,vm-0-11-opencloudos.tail176582.ts.net
http_proxy=http://47.253.255.110:18888
https_proxy=http://47.253.255.110:18888
no_proxy=127.0.0.1,localhost,vm-0-11-opencloudos.tail176582.ts.net
