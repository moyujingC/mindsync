FROM node:20-bookworm-slim AS base
ARG USER_UID=1000
ARG USER_GID=1000
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.cloud.tencent.com/debian|g' /etc/apt/sources.list.d/debian.sources \
  && sed -i 's|http://deb.debian.org/debian-security|http://mirrors.cloud.tencent.com/debian-security|g' /etc/apt/sources.list.d/debian.sources \
  && sed -i 's|https://mirrors.cloud.tencent.com/debian|http://mirrors.cloud.tencent.com/debian|g' /etc/apt/sources.list.d/debian.sources \
  && sed -i 's|https://mirrors.cloud.tencent.com/debian-security|http://mirrors.cloud.tencent.com/debian-security|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::ForceIPv4=true update \
  && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends ca-certificates gosu curl git wget ripgrep python3 python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.4 --activate

RUN usermod -u $USER_UID --non-unique node \
  && groupmod -g $USER_GID --non-unique node \
  && usermod -g $USER_GID -d /paperclip node

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY cli/package.json cli/
COPY server/package.json server/
COPY ui/package.json ui/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/adapter-utils/package.json packages/adapter-utils/
COPY packages/mcp-server/package.json packages/mcp-server/
COPY packages/adapters/claude-local/package.json packages/adapters/claude-local/
COPY packages/adapters/codex-local/package.json packages/adapters/codex-local/
COPY packages/adapters/cursor-local/package.json packages/adapters/cursor-local/
COPY packages/adapters/gemini-local/package.json packages/adapters/gemini-local/
COPY packages/adapters/openclaw-gateway/package.json packages/adapters/openclaw-gateway/
COPY packages/adapters/opencode-local/package.json packages/adapters/opencode-local/
COPY packages/adapters/pi-local/package.json packages/adapters/pi-local/
COPY packages/plugins/sdk/package.json packages/plugins/sdk/
COPY patches/ patches/

RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /app
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @paperclipai/ui build
RUN pnpm --filter @paperclipai/plugin-sdk build
RUN pnpm --filter @paperclipai/server build
RUN test -f server/dist/index.js || (echo "ERROR: server build output missing" && exit 1)

FROM base AS production
ARG USER_UID=1000
ARG USER_GID=1000
ARG HERMES_GIT_REF=v2026.4.13
WORKDIR /app
COPY --chown=node:node --from=build /app /app
RUN npm install --global --omit=dev @anthropic-ai/claude-code@latest @openai/codex@latest opencode-ai @mariozechner/pi-coding-agent \
  && python3 -m venv /opt/hermes \
  && /opt/hermes/bin/python -m pip install --no-cache-dir --upgrade pip \
  && /opt/hermes/bin/python -m pip install --no-cache-dir "git+https://github.com/NousResearch/hermes-agent.git@${HERMES_GIT_REF}" \
  && printf '%s\n' '#!/bin/sh' 'exec /opt/hermes/bin/python -m hermes_cli.main "$@"' > /usr/local/bin/hermes \
  && chmod +x /usr/local/bin/hermes \
  && mkdir -p /paperclip \
  && chown -R node:node /paperclip /opt/hermes

COPY scripts/docker-entrypoint.sh /usr/local/bin/paperclip-entrypoint.sh
RUN chmod +x /usr/local/bin/paperclip-entrypoint.sh \
  && cat <<'EOF' > /usr/local/bin/docker-entrypoint.sh
#!/bin/sh
set -eu

if [ -n "${OPENAI_BASE_URL:-}" ] && [ -n "${OPENAI_API_KEY:-}" ]; then
  mkdir -p /paperclip/.hermes
  /opt/hermes/bin/python - <<'PY'
from pathlib import Path
import os

import yaml

config_path = Path("/paperclip/.hermes/config.yaml")
config = {}
if config_path.exists():
    existing = yaml.safe_load(config_path.read_text()) or {}
    if isinstance(existing, dict):
        config = existing

base_url = os.environ["OPENAI_BASE_URL"]
api_key = os.environ["OPENAI_API_KEY"]
model = os.environ.get("OPENAI_MODEL", "").strip()

config["default_provider"] = "main"
providers = config.setdefault("providers", {})
providers["main"] = {
    "base_url": base_url,
    "api_key": api_key,
    "model": model,
}

auxiliary = config.setdefault("auxiliary", {})
compression = auxiliary.setdefault("compression", {})
compression.update(
    {
        "provider": "custom",
        "base_url": base_url,
        "api_key": api_key,
        "model": model,
    }
)

config_path.write_text(yaml.safe_dump(config, sort_keys=False))
PY
fi

exec /usr/local/bin/paperclip-entrypoint.sh "$@"
EOF
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV NODE_ENV=production \
  HOME=/paperclip \
  HOST=0.0.0.0 \
  PORT=3100 \
  SERVE_UI=true \
  PAPERCLIP_HOME=/paperclip \
  PAPERCLIP_INSTANCE_ID=default \
  USER_UID=${USER_UID} \
  USER_GID=${USER_GID} \
  PAPERCLIP_CONFIG=/paperclip/instances/default/config.json \
  PAPERCLIP_DEPLOYMENT_MODE=authenticated \
  PAPERCLIP_DEPLOYMENT_EXPOSURE=private \
  OPENCODE_ALLOW_ALL_MODELS=true

VOLUME ["/paperclip"]
EXPOSE 3100

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "--import", "./server/node_modules/tsx/dist/loader.mjs", "server/dist/index.js"]
