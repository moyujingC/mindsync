RELAYHUB_DEV_RELAY_BASE_URL=http://127.0.0.1:4319
RELAYHUB_DEV_RELAY_AUTH_TOKEN=relayhub-local-dev-relay
RELAYHUB_CLAUDE_MODEL=relayhub-task-claude-code

ANTHROPIC_BASE_URL=http://127.0.0.1:4319
