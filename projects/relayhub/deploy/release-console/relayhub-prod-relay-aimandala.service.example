[Unit]
Description=RelayHub prod-relay for AI-Mandala
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory={{WORKING_DIRECTORY}}
EnvironmentFile=/etc/default/relayhub-prod-relay-aimandala
ExecStart=/usr/bin/env node src/server.mjs
Restart=always
RestartSec=3
StandardOutput=append:/var/log/relayhub/prod-relay-aimandala.out.log
StandardError=append:/var/log/relayhub/prod-relay-aimandala.err.log

[Install]
WantedBy=multi-user.target
