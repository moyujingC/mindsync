server {
    listen 80;
    server_name relayhub.jingshu.cc;

    root /var/www/relayhub.jingshu.cc;
    index index.html;

    location = /api/control-plane {
        return 301 /api/control-plane/;
    }

    location /api/control-plane/ {
        rewrite ^/api/control-plane/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:4318;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api {
        return 503;
    }

    location /api/ {
        default_type application/json;
        return 503;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

location = /relayhub {
    return 301 /relayhub/;
}

location /relayhub/ {
    alias /var/www/web.jingshu.cc/relayhub/;
    index index.html;
    try_files $uri $uri/ /relayhub/index.html;
}

location = /api {
    return 301 /api/;
}

location /api/ {
    proxy_pass https://<readonly-upstream>/;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
