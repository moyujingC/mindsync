[Unit]
Description=RelayHub Dev Relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory={{WORKING_DIRECTORY}}
EnvironmentFile=/etc/default/relayhub-dev-relay
ExecStart=/usr/bin/env bash -lc 'node src/server.mjs'
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=append:/var/log/relayhub/dev-relay.out.log
StandardError=append:/var/log/relayhub/dev-relay.err.log

[Install]
WantedBy=multi-user.target
